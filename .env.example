# Copy to .env and fill in. Everything except the knowledge-base build needs these.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Deployment names (as created in Azure AI Foundry), not model names. Must exist on your resource.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini         # any tool-calling chat model (gpt-4o, gpt-4.1-mini, ...); not a realtime model
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=               # whisper or gpt-4o-mini-transcribe; leave empty to use browser speech recognition
# AZURE_OPENAI_TRANSCRIBE_API_VERSION=2024-06-01  # only if your transcription deployment needs a different version

# 0 = deterministic. Set to "default" for models that reject a temperature parameter (o-series / gpt-5 family).
AZURE_OPENAI_TEMPERATURE=0

# Embeddings: the shipped index was built with Bedrock Titan v2. Without AWS keys retrieval runs BM25-only.
AZURE_OPENAI_EMBED_DEPLOYMENT=
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
